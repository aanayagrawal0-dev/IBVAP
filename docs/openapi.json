    "/api/watchlist/simulate": {
      "post": {
        "tags": [
          "Watchlist"
        ],
        "summary": "Simulate Watchlist Sighting",
        "description": "Demo/test hook: pretend `camera_id`'s ANPR just read `plate`, running\nthe REAL watchlist check + alert path \u2014 so a match can be demonstrated\nwithout a physical plate or a live OCR model installed. On a match it\nemits the same watchlist_match event + WebSocket alert the live pipeline\nwould (using the camera's latest frame as the thumbnail if it's live).",
        "operationId": "simulate_watchlist_sighting_api_watchlist_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
