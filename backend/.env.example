# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is loaded automatically when the backend starts (see api_server.py's
# load_dotenv() call) — no need to `export` anything by hand every time you
# open a new terminal. Add .env to your .gitignore so your key never gets
# committed; this .example file (with no real secrets in it) is safe to
# commit and share with teammates.
#
# A value set with `export` in your shell always wins over the same name
# in .env, so this is purely a convenience — nothing breaks if you still
# prefer exporting things by hand.

# --- Gemini event explanations (optional) ----------------------------------
# Needed only for the "click a History row to expand its AI analysis"
# feature — everything else works fine without it. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override which Gemini model is used. Leave commented to use the built-in
# default (see src/gemini_explainer.py).
# GEMINI_MODEL=gemini-3.8-flash

# --- Deployment/security hardening -----------------------------------------
# Comma-separated dashboard origins allowed to call this API.
IBVAP_CORS_ORIGINS=http://localhost:3000

# Keep the seeded admin/admin123, rakesh/traffic123 and meena/viewer123 users
# only for local demos. Set to 0 before provisioning real operator accounts.
IBVAP_SEED_DEMO_USERS=1

# Demo-only APIs that inject fake watchlist/route sightings.
IBVAP_ENABLE_DEMO_HOOKS=1

# Login throttling and import-size guardrails.
IBVAP_LOGIN_RATE_LIMIT_WINDOW_S=300
IBVAP_LOGIN_RATE_LIMIT_MAX_FAILURES=5
IBVAP_MAX_CSV_IMPORT_BYTES=200000

