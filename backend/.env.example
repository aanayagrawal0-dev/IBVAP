# --- Live CCTV gateway (Sentinel Gujarat sandbox grid) ------------------------
# The catalogue is the contract: cameras.json (HLS host) or /api/ingest. Use a
# URL, or a local file saved from a logged-in browser session. When set, the
# registry mirrors the catalogue on boot and every IBVAP_GATEWAY_RESYNC_INTERVAL_S.
# IBVAP_GATEWAY_CATALOG=https://cctv.corp8.cloud/cameras.json
# Session cookie if the catalogue URL requires login (never commit it).
# IBVAP_GATEWAY_COOKIE=
# RTSP credentials: your REGISTERED email + access password. Injected into the
# RTSP URL only at open time ('@' sent as %40) — never stored in the DB/logs.
# IBVAP_GATEWAY_EMAIL=
# IBVAP_GATEWAY_PASSWORD=
# rtsp (AI inference, port 8554/TCP) or hls (if 8554 is blocked on your network)
IBVAP_GATEWAY_TRANSPORT=rtsp
# IBVAP_GATEWAY_RTSP_BASE=rtsp://103.250.160.189:8554
# IBVAP_GATEWAY_HLS_BASE=https://cctv.corp8.cloud
# IBVAP_GATEWAY_RTSP_HOSTS=103.250.160.189,stream.corp8.cloud
# Pace your load: each open capture is its own stream copy. Comma-separated
# ids to process, or "all"; unset = first IBVAP_GATEWAY_MAX_ACTIVE live cameras.
# IBVAP_GATEWAY_ACTIVE=cam01,cam04,cam12,cam17
IBVAP_GATEWAY_MAX_ACTIVE=4
IBVAP_GATEWAY_DEPARTMENT=Gujarat Police Sandbox
IBVAP_GATEWAY_RESYNC_INTERVAL_S=300
# HLS session cookie passed to FFmpeg (only needed with TRANSPORT=hls).
# IBVAP_HLS_COOKIE=
# Stream tuning (timing is always PTS-driven; these never set a frame rate).
# IBVAP_STREAM_OPEN_TIMEOUT_MS=10000
# IBVAP_STREAM_READ_TIMEOUT_MS=15000
# IBVAP_PTS_GAP_DISCONTINUITY_S=10
# IBVAP_TRACK_FPS=15

